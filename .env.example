NEXT_PUBLIC_FACTORY_DATASET_MANIFEST_URL=/datasets/factory/datasets.manifest.json
FACTORY_DATASET_ROOT=public/datasets/factory
# Set this to the fork's public URL before publishing.
# NEXT_PUBLIC_SITE_URL=https://example.com
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_HOST_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Community hub (see docs/COMMUNITY.md). Server-side only — never expose the
# service role key to the client.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
COMMUNITY_HASH_SALT=
# Optional: lets the site admin delete any community post via
# DELETE /api/community/plans/<id> with header "x-admin-token: <value>".
COMMUNITY_ADMIN_TOKEN=
# In-game feedback stays disabled unless these and NEXT_PUBLIC_SITE_URL are configured:
# GITHUB_FEEDBACK_TOKEN=
# GITHUB_FEEDBACK_REPO=owner/repository
